# Vercel Environment Variable Configuration
# Rename this file to .env.local for local development
# On Vercel: set this in the project's Environment Variables settings

# Local development (points to your running FastAPI instance)
VITE_API_URL=http://localhost:8000

# Production example (replace with your Render service URL)
# VITE_API_URL=https://your-aura-backend.onrender.com
